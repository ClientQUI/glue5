<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The engine wants ~3 GB of memory. Its address range shrinks to what
	     the OS grants (extended virtual addressing would allow 16 GB, but
	     personal development teams cannot have it and phones need less). -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- iCloud Documents for team 9WKKC8XF38, bundle com.lennertwilhelm.gta5offline.
	     The container has to exist on that App ID; see the README, iCloud. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.lennertwilhelm.gta5offline</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.lennertwilhelm.gta5offline</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
</dict>
</plist>
